# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored - never commit real secrets.

# --- Google OAuth (per-user sign-in) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only needed if not using the default (http://localhost:8000/api/google/callback)
# GOOGLE_OAUTH_REDIRECT_URI=

# --- Google service account (alternative to OAuth, if your Workspace allows it) ---
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json

# --- Apps Script push (fallback if your Workspace blocks both of the above) ---
# Any random string - must exactly match PUSH_TOKEN in the deployed Apps Script.
# APPSSCRIPT_PUSH_TOKEN=

# --- Where the frontend runs, so the OAuth callback can redirect back to it ---
# FRONTEND_URL=http://localhost:5173
